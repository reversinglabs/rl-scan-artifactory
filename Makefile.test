# Makefile tab=tab,ts=4
SHELL := /bin/bash
export SHELL

include Makefile.common

PROGRAM := rl-scan-artifactory-dev

# if set (int) limits the test scan to N items in the repo
# set to 0 to switch off
WITH_TEST_LIMIT_REPO_TO := 10
export WITH_TEST_LIMIT_REPO_TO

# ----------------------------------------------
LOG_LEVEL := DEBUG
export LOG_LEVEL

# ----------------------------------------------
REPO_LIST := $(REPO_LIST_FULL)
# REPO_LIST := --repo $(REPOS_GENERIC)

# ----------------------------------------------
# --ignore-artifactory-properties
SYNC :=
# --sync

OPTIONS_TEST_COMMON := \
	--verbose --log-to-stderr \
	--pack-safe \
	--ignore-cert-errors \
	--download=$(DOWNLOAD_PATH) \
	$(REPO_LIST)

# rl-store may not exist on test machines
#	--cli-reports-repo="Spectra-Assure-Reports"
CLI_COMMON := \
	--cli-reports-repo="Spectra-Assure-Reports" \
	--cli-rlstore-path=$$HOME/tmp/rl-secure \
	--cli-report-types=all

CLI_OPTIONS := --cli $(CLI_COMMON) \
	--cli-rlsecure-path=$$HOME/tmp/rl-secure

# cli-docker currently as no sync possibility (fail on --sync)
CLI_DOCKER_OPTIONS := --cli-docker 	$(CLI_COMMON)

OPTIONS_TEST_CLI := $(OPTIONS_TEST_COMMON) 				$(CLI_OPTIONS)
OPTIONS_TEST_CLI_DOCKER := $(OPTIONS_TEST_COMMON) 		$(CLI_DOCKER_OPTIONS)
OPTIONS_TEST_PORTAL := $(OPTIONS_TEST_COMMON) 			--portal
OPTIONS_TEST_CLOUD := $(OPTIONS_TEST_COMMON) 			$(CLI_OPTIONS)

# ----------------------------------------------
# test: prep_test test_portal test_cli_docker
test: prep_test test_cli test_portal test_cli_docker

prep_test:
	mkdir -p $(DOWNLOAD_PATH)

test_cli:
	source $(ENV_FILE_CLI); \
	$(COMMON_RUN) $(PROGRAM).py $(OPTIONS_TEST_CLI) $(SYNC) 2>$@.2 | tee $@.1
	mv $(PROGRAM).log $@.log

test_cli_docker:
	source $(ENV_FILE_CLI); \
	$(COMMON_RUN) $(PROGRAM).py $(OPTIONS_TEST_CLI_DOCKER) -I 2>$@.2 | tee $@.1
	mv $(PROGRAM).log $@.log

test_portal:
	source $(ENV_FILE_PORTAL); \
	$(COMMON_RUN) $(PROGRAM).py $(OPTIONS_TEST_PORTAL) $(SYNC) 2>$@.2 | tee $@.1
	mv $(PROGRAM).log $@.log
	grep -v INFO $@.log

test_cloud:
	source $(ENV_FILE_CLOUD); \
	$(COMMON_RUN) $(PROGRAM).py $(OPTIONS_TEST_CLOUD) $(SYNC) 2>$@.2 | tee $@.1
	mv $(PROGRAM).log $@.log
