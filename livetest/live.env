# Shared settings for the live tests; sourced, not run.
# The Artifactory host, user and token come from the same env file the
# Makefile.test runs use (ENV_FILE_CLI in Makefile.common).
ENV_FILE="${ENV_FILE:-${HOME}/.env_cli}"
# shellcheck disable=SC1090
source "${ENV_FILE}"

# A generic LOCAL repository used only for these tests: every run scans the
# whole repository, so anything else in it would be scanned too.
REPO="${REPO:-rl-live-generic}"
DIR="${DIR:-live-test}" # DIR=live-1.2.0 to work with items an older kit set up

BASE="https://${ARTIFACTORY_HOST}/artifactory"
CURL=(curl -fsS -k -u "${ARTIFACTORY_USER}:${ARTIFACTORY_TOKEN}")

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORK="${HERE}/work" # generated test files; removed by 90-cleanup.sh

die() { echo "ERROR: $*" >&2; exit 1; }

# set_props <path in repo> "k1=v1;k2=v2"
set_props() {
    "${CURL[@]}" -X PUT "${BASE}/api/storage/${REPO}/${DIR}/$1?properties=$2&recursive=0" >/dev/null
}

# del_props <path in repo> "k1,k2"
del_props() {
    "${CURL[@]}" -X DELETE "${BASE}/api/storage/${REPO}/${DIR}/$1?properties=$2&recursive=0" >/dev/null
}

# props <path in repo>: the properties as "key=value" lines, sorted; nothing
# for an item without any (Artifactory answers that with a 404)
props() {
    local body
    body=$("${CURL[@]}" "${BASE}/api/storage/${REPO}/${DIR}/$1?properties" 2>/dev/null) || return 0
    python3 -c 'import json,sys
try:
    d = json.loads(sys.argv[1]).get("properties", {})
except ValueError:
    d = {}
for k in sorted(d): print(f"{k}={d[k][0]}")' "${body}"
}

# The items, one letter per case (see README.md):
#   a  RL.meta.* complete, no side-car           -> real purl from properties
#   b  side-car AND RL.meta.* (other values)     -> side-car wins
#   c  only RL.meta.name                          -> FAIL naming RL.meta.version
#   d  nothing                                    -> cli placeholder; portal skips
#   e  side-car without version (unreadable)      -> FAIL for the side-car only
#   f  side-car only                              -> control
#   g  RL.meta.* complete; version removed later  -> FAIL once a sync needs it
ITEMS="a b c d e f g"

# Gradle (R4.1.7): a gradle LOCAL repository used only for these tests, with
# the layout Artifactory gives it by default, maven-2-default. GDIR is the group
# folder (the groupId as folders); the items are relative to it.
GREPO="${GREPO:-rl-live-gradle}"
GDIR="org/example/livetest"
#   mylib 1.0 and 2.0 jars           -> scanned, purl <repo>/org.example.livetest.mylib@<version>
#   the 1.0 .pom and .module          -> not candidates: never listed
GFILES="mylib/1.0/mylib-1.0.jar mylib/1.0/mylib-1.0.pom mylib/1.0/mylib-1.0.module mylib/2.0/mylib-2.0.jar"

# the files 20-show.sh lists, relative to ${DIR}: the gradle ones when REPO is GREPO
show_files() {
    if [ "${REPO}" = "${GREPO}" ]; then
        echo "${GFILES}"
    else
        for i in ${ITEMS}; do echo "${i}1.tgz ${i}1.rl_meta"; done
    fi
}
